{
  "name": "sinag",
  "version": "0.1.0",
  "private": true,
  "description": "Sinag — a ray of light on what your SK is doing. Transparency bulletin board and AI assistants for Sangguniang Kabataan councils.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "node scripts/db-setup.mjs --seed",
    "db:passwords": "node scripts/reset-demo-passwords.mjs",
    "db:admin": "node scripts/make-account.mjs --admin",
    "db:chair": "node scripts/make-account.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
