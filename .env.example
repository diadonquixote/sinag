# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables.

# Postgres connection string (Neon, Supabase, or any Postgres).
# Use the *pooled* connection string on Vercel.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random secret used to sign login cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Name shown in the header and footer, e.g. "SK ng Barangay San Isidro".
NEXT_PUBLIC_ORG_NAME=Sangguniang Kabataan

# --- AI assistants (Nebius Token Factory, OpenAI-compatible) ---
# Without these, Sinag still works: assistants fall back to simple template drafts.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Text model for minutes, reports and proposals (a Nemotron model ID from your Nebius console).
NEBIUS_MODEL=
# Vision-capable model for turning photos of handwritten notes into text (optional).
NEBIUS_VISION_MODEL=

# Password given to the demo accounts created by `npm run db:seed` (demo data only).
SEED_PASSWORD=
