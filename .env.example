# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables.

# Postgres connection string (Neon, Supabase, or any Postgres).
# Use the *pooled* connection string on Vercel.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random secret (32+ characters) used to sign login cookies:  openssl rand -base64 32
# The build stops if this or DATABASE_URL is missing.
AUTH_SECRET=

# Name shown in the header and footer, e.g. "SK ng Barangay San Isidro".
NEXT_PUBLIC_ORG_NAME=Sangguniang Kabataan

# What kind of site this is: pilot (default, shows a banner that the paper records are
# official), live (no banner, once the council has adopted it), or demo (made-up data).
SINAG_STAGE=pilot

# The council's privacy officer, shown on the privacy notice once named.
PRIVACY_CONTACT_NAME=
PRIVACY_CONTACT_EMAIL=

# Demo sites only: the demo password, shown on the login page.
# DEMO_PASSWORD=

# Where the source code is (the footer links to it). Defaults to the original repository.
# NEXT_PUBLIC_SOURCE_URL=

# --- AI assistants ---
# Without a key, Sinag still works: the assistants fall back to simple template drafts.
#
# Easiest free setup: get a key at https://aistudio.google.com/apikey and paste it below.
# Gemini reads photos too, so handwritten notes and receipts work.
GEMINI_API_KEY=

# Optional backup, also free, but TEXT ONLY — it cannot read photos.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Which provider to use: gemini | groq | nebius.
# Leave blank and Sinag picks whichever key above is filled in.
AI_PROVIDER=

# Only needed to override the built-in defaults, e.g. when a model ID changes.
# AI_MODEL=
# AI_VISION_MODEL=
# AI_BASE_URL=
# AI_API_KEY=

# Password given to the demo accounts created by `npm run db:seed` (demo data only).
SEED_PASSWORD=
