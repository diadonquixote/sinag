# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables.

# Postgres connection string (Neon, Supabase, or any Postgres).
# Use the *pooled* connection string on Vercel.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random secret used to sign login cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Name shown in the header and footer, e.g. "SK ng Barangay San Isidro".
NEXT_PUBLIC_ORG_NAME=Sangguniang Kabataan

# --- AI assistants ---
# Without a key, Sinag still works: the assistants fall back to simple template drafts.
#
# Easiest free setup: get a key at https://aistudio.google.com/apikey and paste it below.
# Gemini reads photos too, so handwritten notes and receipts work.
GEMINI_API_KEY=

# Optional backup, also free, but TEXT ONLY — it cannot read photos.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Which provider to use: gemini | groq | nebius.
# Leave blank and Sinag picks whichever key above is filled in.
AI_PROVIDER=

# Only needed to override the built-in defaults, e.g. when a model ID changes.
# AI_MODEL=
# AI_VISION_MODEL=
# AI_BASE_URL=
# AI_API_KEY=

# Password given to the demo accounts created by `npm run db:seed` (demo data only).
SEED_PASSWORD=
